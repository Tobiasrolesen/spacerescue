{
  "name": "spacerescue",
  "version": "1.0.0",
  "description": "SpaceRescue - galaksens redningscentral. REST API med Node.js, Express og MongoDB",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "winston": "^3.19.0"
  }
}
