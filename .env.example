# Kopiér denne fil til .env og tilpas værdierne.
# .env må aldrig committes (den står i .gitignore).

# Porten SpaceRescue-API'et lytter på
PORT=3000

# Forbindelse til lokal MongoDB (databasen "spacerescue" oprettes automatisk)
MONGODB_URI=mongodb://localhost:27017/spacerescue

# Adressen på det eksterne informationssystem (bruges fra Issue #10)
INFORMATION_SYSTEM_URL=http://localhost:4000
